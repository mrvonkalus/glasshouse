{
  "name": "glasshouse",
  "version": "1.0.0",
  "description": "Deterministic property and differential test harnesses for finding and explaining semantic drift.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:middleware": "npm run build --silent",
    "demo": "npm run build --silent && node .build/demo/glob-route-drift.js",
    "demo:svg": "npm run build --silent && node .build/demo/render-demo-svg.js",
    "glob:middleware": "npm run build --silent && node .build/harnesses/glob-middleware-drift.js",
    "glob:middleware:json": "npm run build --silent && node .build/harnesses/glob-middleware-drift.js --json",
    "test": "npm run build --silent && node --test .build/test/*.test.js",
    "test:middleware": "npm test --silent",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "node verify.js && npm test --silent"
  },
  "keywords": [
    "differential-testing",
    "property-testing",
    "security-research",
    "software-testing"
  ],
  "author": "Kristopher Renfro",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "diff": "^9.0.0",
    "fast-json-patch": "^3.1.1",
    "minimatch": "^10.2.6",
    "picomatch": "^4.0.5",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  },
  "private": false
}
